From c9e65e01f4d1c043843b13f9c1acf5e4d88fe803 Mon Sep 17 00:00:00 2001
From: Maciej Pijanowski <maciej.pijanowski@3mdeb.com>
Date: Mon, 30 Jan 2023 17:24:07 +0100
Subject: [PATCH] Makefile: add sio.o to OBJS for x86 internal programmer

Change-Id: I6811cf59b30bb829bf6ff8d43d9a6fc5a079dacc
Signed-off-by: Maciej Pijanowski <maciej.pijanowski@3mdeb.com>
---
 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 9e843714b1ed..0e3ee99bbbd3 100644
--- a/Makefile
+++ b/Makefile
@@ -598,7 +598,7 @@ ifeq ($(CONFIG_INTERNAL) $(CONFIG_INTERNAL_X86), yes yes)
 FEATURE_FLAGS += -D'CONFIG_INTERNAL=1'
 PROGRAMMER_OBJS += processor_enable.o chipset_enable.o board_enable.o cbtable.o \
 	internal.o it87spi.o sb600spi.o amd_imc.o wbsio_spi.o mcp6x_spi.o \
-	ichspi.o dmi.o known_boards.o
+	ichspi.o dmi.o known_boards.o sio.o
 endif
 else
 ifeq ($(CONFIG_INTERNAL), yes)
-- 
