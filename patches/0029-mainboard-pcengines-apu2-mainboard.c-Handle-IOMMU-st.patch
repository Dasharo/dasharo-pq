From 024c75ac3a92fe7dd4c9ca0c9e89a2b7ec53b43d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Fri, 30 May 2025 12:19:19 +0200
Subject: [PATCH 29/88] mainboard/pcengines/apu2/mainboard.c: Handle IOMMU
 state via devicetree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable or disable the IOMMU according to the option set in the setup
(sortbootorder). Also pass the IOMMU device state to AGESA InitEnv,
so that AGESA does not enable the IOMMU when it is disabled in the
devicetree. Without that the IOMMU stays visible in the OS.

Upstream-Status: Inappropriate [Should utilize existing option backend]
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
diff --git a/src/mainboard/pcengines/apu2/mainboard.c b/src/mainboard/pcengines/apu2/mainboard.c
index 6b4efe956fa0..d4d751ee6d49 100644
--- a/src/mainboard/pcengines/apu2/mainboard.c
+++ b/src/mainboard/pcengines/apu2/mainboard.c
@@ -358,6 +358,17 @@ static void mainboard_enable(struct device *dev)
 
 	/* Initialize the PIRQ data structures for consumption */
 	pirq_setup();
+
+	/* Enable IOMMU if activated in config file */
+	struct device* iommu_dev;
+	iommu_dev = pcidev_on_root(0, 2);
+
+	if (iommu_dev) {
+		if (check_iommu())
+			iommu_dev->enabled = 1;
+		else
+			iommu_dev->enabled = 0;
+	}
 #if CONFIG(GENERATE_SMBIOS_TABLES)
 	dev->ops->get_smbios_data = mainboard_smbios_data;
 #endif
diff --git a/src/northbridge/amd/pi/00730F01/state_machine.c b/src/northbridge/amd/pi/00730F01/state_machine.c
index a05e9e04e814..980e06769e70 100644
--- a/src/northbridge/amd/pi/00730F01/state_machine.c
+++ b/src/northbridge/amd/pi/00730F01/state_machine.c
@@ -40,7 +40,11 @@ void platform_AfterInitPost(struct sysinfo *cb, AMD_POST_PARAMS *Post)
 
 void platform_BeforeInitEnv(struct sysinfo *cb, AMD_ENV_PARAMS *Env)
 {
+	const struct device *iommu_dev = pcidev_on_root(0, 2);
+
 	EmptyHeap();
+
+	Env->GnbEnvConfiguration.IommuSupport = iommu_dev && iommu_dev->enabled;
 }
 
 void platform_AfterInitEnv(struct sysinfo *cb, AMD_ENV_PARAMS *Env)
