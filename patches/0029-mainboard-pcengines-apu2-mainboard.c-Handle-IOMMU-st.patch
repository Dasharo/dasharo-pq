From 024c75ac3a92fe7dd4c9ca0c9e89a2b7ec53b43d Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Fri, 30 May 2025 12:19:19 +0200
Subject: [PATCH 29/88] mainboard/pcengines/apu2/mainboard.c: Handle IOMMU
 state via devicetree
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Enable or disable the IOMMU according to the option set in the setup
(sortbootorder). Also pass the option to AGESA in the AmdInitEnv hook,
which runs before mainboard_enable(), so that AGESA does not enable
the IOMMU when it is disabled. Without that the IOMMU stays visible
in the OS.

Upstream-Status: Inappropriate [Should utilize existing option backend]
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
diff --git a/src/mainboard/pcengines/apu2/OemCustomize.c b/src/mainboard/pcengines/apu2/OemCustomize.c
index 95af6ef92d56..ac18b25c1a58 100644
--- a/src/mainboard/pcengines/apu2/OemCustomize.c
+++ b/src/mainboard/pcengines/apu2/OemCustomize.c
@@ -2,6 +2,7 @@
 
 #include <AGESA.h>
 #include <northbridge/amd/agesa/state_machine.h>
+#include "bios_knobs.h"
 
 #include "gpio_ftns.h"
 
@@ -94,3 +95,8 @@ void board_BeforeInitPost(struct sysinfo *cb, AMD_POST_PARAMS *Post)
 	else
 		Post->MemConfig.EnableEccFeature = FALSE;
 }
+
+void board_BeforeInitEnv(struct sysinfo *cb, AMD_ENV_PARAMS *Env)
+{
+	Env->GnbEnvConfiguration.IommuSupport = check_iommu();
+}
diff --git a/src/mainboard/pcengines/apu2/mainboard.c b/src/mainboard/pcengines/apu2/mainboard.c
index fa502c5e93bf..cd416347a412 100644
--- a/src/mainboard/pcengines/apu2/mainboard.c
+++ b/src/mainboard/pcengines/apu2/mainboard.c
@@ -361,6 +361,17 @@ static void mainboard_enable(struct device *dev)
 
 	/* Initialize the PIRQ data structures for consumption */
 	pirq_setup();
+
+	/* Enable IOMMU if activated in config file */
+	struct device* iommu_dev;
+	iommu_dev = pcidev_on_root(0, 2);
+
+	if (iommu_dev) {
+		if (check_iommu())
+			iommu_dev->enabled = 1;
+		else
+			iommu_dev->enabled = 0;
+	}
 #if CONFIG(GENERATE_SMBIOS_TABLES)
 	dev->ops->get_smbios_data = mainboard_smbios_data;
 #endif
