Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream-Status: Pending
Signed-off-by: Michał Kopeć <michal.kopec@3mdeb.com>
diff --git a/src/soc/amd/common/block/psp/psp_efs.c b/src/soc/amd/common/block/psp/psp_efs.c
index 84632b416899..d3de2bce9054 100644
--- a/src/soc/amd/common/block/psp/psp_efs.c
+++ b/src/soc/amd/common/block/psp/psp_efs.c
@@ -17,7 +17,7 @@ bool read_efs_spi_settings(uint8_t *mode, uint8_t *speed)
 		return false;
 
 	if (efs->signature == EMBEDDED_FW_SIGNATURE) {
-		if (CONFIG(SOC_AMD_STONEYRIDGE)) {
+		if (CONFIG(SOC_AMD_STONEYRIDGE) || CONFIG(NORTHBRIDGE_AMD_PI_00730F01)) {
 			*mode = efs->spi_readmode_f15_mod_60_6f;
 			*speed = efs->fast_speed_new_f15_mod_60_6f;
 			ret = true;
