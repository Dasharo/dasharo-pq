Date: Sat, 23 Nov 2024 10:46:21 +0100
Subject: [PATCH] northbridge/amd/pi/00730F01/acpi/northbridge.asl: Add
 IOMMU device
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Upstream-Status: Pending
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>

diff --git a/src/northbridge/amd/pi/00730F01/acpi/northbridge.asl b/src/northbridge/amd/pi/00730F01/acpi/northbridge.asl
index c5f60b94ff86..e6dd08d07ebc 100644
--- a/src/northbridge/amd/pi/00730F01/acpi/northbridge.asl
+++ b/src/northbridge/amd/pi/00730F01/acpi/northbridge.asl
@@ -35,6 +35,19 @@ Device(PCSD) { /* Processor configuration space devices */
 	Name(_ADR, 0x00180000)	/* Dev# = BSP Dev#, Func# = 0 */
 }
 
+Device(IOMU) {
+	Name(_ADR, 0x00000002)
+
+	Method(_PRT,0, NotSerialized)
+	{
+		If(PICM)
+		{
+			Return(APR0)	/* APIC mode */
+		}
+		Return (PR0)		/* PIC Mode */
+	}
+} /* end IOMU */
+
 /* Gpp 0 */
 Device(PBR4) {
 	Name(_ADR, 0x00020001)
