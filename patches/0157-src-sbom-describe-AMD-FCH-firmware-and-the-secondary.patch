From 36ec2f5777341e5d0f63628dec9db83e5fd4b7c0 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Mon, 2 Nov 2026 14:53:32 +0100
Subject: [PATCH 157/158] src/sbom: describe AMD FCH firmware and the secondary
 payloads
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Some components built into PC Engines apu images had no SBOM entry:

 - xHCI and IMC firmware of AMD Hudson/Bolton/Avalon FCH, which
   amdfwtool places in the ROMSIG area next to the PSP directory.
   They are not PSP directory entries, so the amdfwtool generated SBOM
   does not cover them. The blobs carry no version, so record the
   commit of the repository holding them (as for the IFD), the SHA-256
   of the blob and SBOM_AMD_BLOB_LICENSE.
 - sortbootorder and Memtest86+ secondary payloads. Record the
   checked out commit and the latest tag, like for the main payload,
   and the SHA-256 of the built payload.

Add SBOM_HUDSON_XHCI_FW, SBOM_HUDSON_IMC_FW, SBOM_SORTBOOTORDER and
SBOM_MEMTEST with the corresponding CoSWID templates. Tag-ids are
name-based UUIDs as generated by 'goswid generate-tag-id'.

Upstream-Status: Pending
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
---
 src/sbom/Kconfig                    | 43 ++++++++++++++++++
 src/sbom/Makefile.mk                | 69 +++++++++++++++++++++++++++++
 src/sbom/amd-hudson-imc.json        | 26 +++++++++++
 src/sbom/amd-hudson-xhci.json       | 26 +++++++++++
 src/sbom/payload-memtest86plus.json | 32 +++++++++++++
 src/sbom/payload-sortbootorder.json | 32 +++++++++++++
 6 files changed, 228 insertions(+)
 create mode 100644 src/sbom/amd-hudson-imc.json
 create mode 100644 src/sbom/amd-hudson-xhci.json
 create mode 100644 src/sbom/payload-memtest86plus.json
 create mode 100644 src/sbom/payload-sortbootorder.json

diff --git a/src/sbom/Kconfig b/src/sbom/Kconfig
index 4538ede811..f0158ccd0f 100644
--- a/src/sbom/Kconfig
+++ b/src/sbom/Kconfig
@@ -502,6 +502,49 @@ config SBOM_AMD_PSP_FW
 	    - Key store types (0x50, 0x51) and SEV driver (0x1a, if the
 	      $PS1 magic is present) are treated as regular PSP FW.
 
+config SBOM_HUDSON_XHCI_FW
+	bool "Include AMD FCH XHCI firmware metadata in SBOM"
+	default n
+	depends on HUDSON_XHCI_FWM
+	help
+	  Select this option to include a coswid (Concise Software
+	  Identification Tag) of the xHCI controller firmware added to the
+	  ROMSIG area of AMD Hudson/Bolton/Avalon FCH (HUDSON_XHCI_FWM_FILE).
+	  The blob carries no version, so the commit of the repository holding
+	  it is recorded as the version together with the SHA-256 of the blob.
+
+config SBOM_HUDSON_IMC_FW
+	bool "Include AMD FCH IMC firmware metadata in SBOM"
+	default n
+	depends on HUDSON_IMC_FWM
+	help
+	  Select this option to include a coswid (Concise Software
+	  Identification Tag) of the Integrated Micro-Controller firmware added
+	  to the ROMSIG area of AMD Hudson/Bolton/Avalon FCH
+	  (HUDSON_IMC_FWM_FILE). The blob carries no version, so the commit of
+	  the repository holding it is recorded as the version together with
+	  the SHA-256 of the blob.
+
+config SBOM_SORTBOOTORDER
+	bool "Include sortbootorder metadata in SBOM"
+	default n
+	depends on SORTBOOTORDER_SECONDARY_PAYLOAD
+	help
+	  Select this option to include a coswid (Concise Software
+	  Identification Tag) of the sortbootorder secondary payload. The
+	  version is taken from the git checkout of the payload and the SHA-256
+	  of the built payload is recorded.
+
+config SBOM_MEMTEST
+	bool "Include Memtest86+ metadata in SBOM"
+	default n
+	depends on MEMTEST_SECONDARY_PAYLOAD
+	help
+	  Select this option to include a coswid (Concise Software
+	  Identification Tag) of the Memtest86+ secondary payload. The version
+	  is taken from the git checkout of the payload and the SHA-256 of the
+	  built payload is recorded.
+
 config SBOM_VGA_BIOS
 	bool "Include primary VGA BIOS Option ROM metadata in SBOM"
 	depends on VGA_BIOS
diff --git a/src/sbom/Makefile.mk b/src/sbom/Makefile.mk
index 329aa69083..4ea79eed09 100644
--- a/src/sbom/Makefile.mk
+++ b/src/sbom/Makefile.mk
@@ -63,6 +63,12 @@ CONFIG_LINUXBOOT_KERNEL_VERSION := $(call strip_quotes, $(CONFIG_LINUXBOOT_KERNE
 CONFIG_LINUXBOOT_UROOT_VERSION  := $(call strip_quotes, $(CONFIG_LINUXBOOT_UROOT_VERSION))
 CONFIG_PAYLOAD_FILE        := $(call strip_quotes, $(CONFIG_PAYLOAD_FILE))
 CONFIG_SBOM_MANUFACTURER   := $(call strip_quotes, $(CONFIG_SBOM_MANUFACTURER))
+sbom-hudson-xhci-file      := $(call strip_quotes, $(CONFIG_HUDSON_XHCI_FWM_FILE))
+sbom-hudson-imc-file       := $(call strip_quotes, $(CONFIG_HUDSON_IMC_FWM_FILE))
+sbom-sortbootorder-dir     := payloads/external/sortbootorder/sortbootorder
+sbom-sortbootorder-file    := $(sbom-sortbootorder-dir)/sortbootorder.elf
+sbom-memtest-dir           := payloads/external/Memtest86Plus/$(if $(CONFIG_MEMTEST86PLUS_V6),memtest86plus_v6,memtest86plus_v5)
+sbom-memtest-file          := $(sbom-memtest-dir)/memtest
 
 # Select the correct payload directory for the used payload. Ideally we could just make this
 # a one-liner, but since the payload is generated externally (with an extra make command), we
@@ -106,6 +112,8 @@ payload-swid-ready-dep := $(wildcard $(payload-git-dir-y)/.git)
 ipxe-swid-ready-dep := $(wildcard payloads/external/iPXE/ipxe/.git)
 edk2-platforms-swid-ready-dep := $(wildcard payloads/external/edk2/workspace/edk2-platforms/.git)
 stm-swid-ready-dep := $(wildcard $(sbom-stm-file))
+sortbootorder-swid-ready-dep := $(wildcard $(sbom-sortbootorder-dir)/.git)
+memtest-swid-ready-dep := $(wildcard $(sbom-memtest-dir)/.git)
 else
 payload-swid-ready-dep := $(CONFIG_PAYLOAD_FILE)
 ipxe-swid-ready-dep := payloads/external/iPXE/ipxe/ipxe.rom
@@ -113,6 +121,8 @@ ipxe-swid-ready-dep := payloads/external/iPXE/ipxe/ipxe.rom
 # SBOM extraction on the built payload file being ready.
 edk2-platforms-swid-ready-dep := $(CONFIG_PAYLOAD_FILE)
 stm-swid-ready-dep := $(sbom-stm-file)
+sortbootorder-swid-ready-dep := $(sbom-sortbootorder-file)
+memtest-swid-ready-dep := $(sbom-memtest-file)
 endif
 
 # Add all SBOM files into the swid-files-y target. This target contains all
@@ -163,6 +173,10 @@ swid-files-$(CONFIG_SBOM_SINIT_ACM) += \
 		$(CONFIG_SBOM_SINIT_ACM_PATH))
 
 swid-files-$(CONFIG_SBOM_IPXE) += $(if $(CONFIG_SBOM_IPXE_GENERATE),$(build-dir)/payload-iPXE.json,$(CONFIG_SBOM_IPXE_PATH))
+swid-files-$(CONFIG_SBOM_HUDSON_XHCI_FW) += $(build-dir)/amd-hudson-xhci.json
+swid-files-$(CONFIG_SBOM_HUDSON_IMC_FW) += $(build-dir)/amd-hudson-imc.json
+swid-files-$(CONFIG_SBOM_SORTBOOTORDER) += $(build-dir)/payload-sortbootorder.json
+swid-files-$(CONFIG_SBOM_MEMTEST) += $(build-dir)/payload-memtest86plus.json
 swid-files-$(CONFIG_SBOM_STM) += $(if $(CONFIG_SBOM_STM_GENERATE),$(build-dir)/stm.json,$(CONFIG_SBOM_STM_PATH))
 # Proprietary graphics/network binary blobs (VGA BIOS OptionROMs, edk2 GOP and
 # LAN drivers).  In GENERATE mode a minimal template + blob hash is emitted;
@@ -1016,6 +1030,61 @@ $(payload-swid): $(payload-swid-template) | $(build-dir) $(build-dir)/goswid $(p
 	fi
 endif
 
+# AMD Hudson/Bolton/Avalon FCH firmware (xHCI and IMC) stored in the ROMSIG
+# area by amdfwtool.  The blobs carry no version, so use the commit of the
+# repository holding them as "<commit-date>_<hash>", mirroring the Intel Flash
+# Descriptor rule, and record the SHA-256 of the blob.
+# $(1): blob file
+amd-hudson-fw-sbom = \
+	set -e; \
+	git_root=$$(git -C "$$(dirname "$(1)")" rev-parse --show-toplevel 2>/dev/null || true); \
+	if [ -n "$$git_root" ]; then \
+		comm_hash=$$(git -C "$$git_root" log -n 1 --format="%cs_%H" -- "$$(realpath "$(1)")"); \
+		sed -i -e "s/<software_version>/$$comm_hash/" -e "/<colloquial_version>/d" $@; \
+	else \
+		sed -i -e "/software-version/d" -e "/<colloquial_version>/d" $@; \
+	fi; \
+	if [ -s "$(1)" ]; then \
+		$(build-dir)/goswid add-payload-file -o $@ -i $@ \
+			--name "$(notdir $(1))" \
+			--hash "$$(sha256sum "$(1)" | cut -d' ' -f1)"; \
+	fi; \
+	$(if $(CONFIG_SBOM_AMD_BLOB_LICENSE),$(build-dir)/goswid add-license -o $@ -i $@ "$(CONFIG_SBOM_AMD_BLOB_LICENSE)",:)
+
+$(build-dir)/amd-hudson-xhci.json: $(src-dir)/amd-hudson-xhci.json $(wildcard $(sbom-hudson-xhci-file)) | $(build-dir) $(build-dir)/goswid
+	cp $< $@
+	$(call amd-hudson-fw-sbom,$(sbom-hudson-xhci-file))
+
+$(build-dir)/amd-hudson-imc.json: $(src-dir)/amd-hudson-imc.json $(wildcard $(sbom-hudson-imc-file)) | $(build-dir) $(build-dir)/goswid
+	cp $< $@
+	$(call amd-hudson-fw-sbom,$(sbom-hudson-imc-file))
+
+# Secondary payloads built from their own git checkouts.  Use the checked out
+# commit as "<commit-date>_<hash>" and the latest tag as colloquial version,
+# like for the main payload, and record the SHA-256 of the built payload.
+# $(1): git checkout, $(2): built payload file
+secondary-payload-sbom = \
+	if [ -e "$(1)/.git" ]; then \
+		git_comm_hash=$$(git --git-dir $(1)/.git log -n 1 --format="%cs_%H"); \
+		git_latest_rel=$$(git --git-dir $(1)/.git tag --merged HEAD --sort=-creatordate | head -n1); \
+		sed -i -e "s/<colloquial_version>/$$git_latest_rel/" -e "s/<software_version>/$$git_comm_hash/" $@; \
+	else \
+		sed -i -e "/<colloquial_version>/d" -e "/<software_version>/d" $@; \
+	fi; \
+	if [ -s "$(2)" ]; then \
+		$(build-dir)/goswid add-payload-file -o $@ -i $@ \
+			--name "$(notdir $(2))" \
+			--hash "$$(sha256sum "$(2)" | cut -d' ' -f1)"; \
+	fi
+
+$(build-dir)/payload-sortbootorder.json: $(src-dir)/payload-sortbootorder.json | $(build-dir) $(build-dir)/goswid $(sortbootorder-swid-ready-dep)
+	cp $< $@
+	$(call secondary-payload-sbom,$(sbom-sortbootorder-dir),$(sbom-sortbootorder-file))
+
+$(build-dir)/payload-memtest86plus.json: $(src-dir)/payload-memtest86plus.json | $(build-dir) $(build-dir)/goswid $(memtest-swid-ready-dep)
+	cp $< $@
+	$(call secondary-payload-sbom,$(sbom-memtest-dir),$(sbom-memtest-file))
+
 ## Standalone SBOM regeneration target
 ## Rebuilds build/sbom/sbom.uswid from existing build artifacts without
 ## requiring a full rebuild. Useful for updating the SBOM after post-build
