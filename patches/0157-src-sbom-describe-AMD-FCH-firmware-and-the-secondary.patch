+  "tag-version": 0,
+  "software-name": "AMD FCH IMC Firmware",
+  "software-version": "<software_version>",
+  "version-scheme": "alphanumeric",
+  "software-meta": [
+    {
+      "colloquial-version": "<colloquial_version>",
+      "product": "AMD Hudson/Bolton FCH Integrated Micro-Controller firmware",
+      "persistent-id": "com.amd.fch.imc",
+      "summary": "Proprietary firmware for the Integrated Micro-Controller (IMC) of AMD Hudson/Bolton/Avalon FCH, placed in the ROMSIG area loaded by the FCH. The blob carries no version; software-version records the commit of the blob repository."
+    }
