From 6dbcfdecf46f664dc687c7407525eba47a91ea33 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Mon, 2 Nov 2026 15:31:29 +0100
Subject: [PATCH 160/161] util/amdfwtool: add --sbom-tag-id option
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Allow forcing one CoSWID tag-id on all SBOM tags amdfwtool generates,
instead of the per-blob tag-ids, so that the platform can identify all
blobs of its AMD firmware package with a single tag-id. The value must
be a UUID.

Upstream-Status: Pending
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
---
 util/amdfwtool/amdfwtool.h |  1 +
 util/amdfwtool/opts.c      | 11 +++++++++++
 util/amdfwtool/sbom.c      | 26 +++++++++++++++++++++++++-
 3 files changed, 37 insertions(+), 1 deletion(-)

diff --git a/util/amdfwtool/amdfwtool.h b/util/amdfwtool/amdfwtool.h
index 21e9eca51c..dc7dfae3f5 100644
--- a/util/amdfwtool/amdfwtool.h
+++ b/util/amdfwtool/amdfwtool.h
@@ -230,6 +230,7 @@ void process_signed_psp_firmwares(const char *signed_rom,
 		uint64_t signed_start_addr,
 		enum platform soc_id);
 int find_bios_entry(enum amd_bios_type type);
+bool sbom_set_tag_id(const char *tag_id);
 void generate_sbom_psp(const char *sbom_dir, amd_fw_entry *fw_table,
 		       const char *license_href);
 void generate_sbom_bios(const char *sbom_dir, struct amd_bios_entry *fw_table,
diff --git a/util/amdfwtool/opts.c b/util/amdfwtool/opts.c
index 0efbf700dd..a87ccd818d 100644
--- a/util/amdfwtool/opts.c
+++ b/util/amdfwtool/opts.c
@@ -64,6 +64,7 @@ enum {
 	AMDFW_OPT_RECOVERY_B_LOCATION,
 	AMDFW_OPT_SBOM_DIR,
 	AMDFW_OPT_SBOM_LICENSE,
+	AMDFW_OPT_SBOM_TAG_ID,
 	/* begin after ASCII characters */
 	LONGOPT_SPI_READ_MODE	= 256,
 	LONGOPT_SPI_SPEED	= 257,
@@ -154,6 +155,7 @@ static struct option long_options[] = {
 	{"help",             no_argument,       0, AMDFW_OPT_HELP },
 	{"sbom-dir",         required_argument, 0, AMDFW_OPT_SBOM_DIR },
 	{"sbom-license",     required_argument, 0, AMDFW_OPT_SBOM_LICENSE },
+	{"sbom-tag-id",      required_argument, 0, AMDFW_OPT_SBOM_TAG_ID },
 	{NULL,               0,                 0,  0  }
 };
 
@@ -252,6 +254,8 @@ static void usage(void)
 	printf("                                PSP firmware blobs into DIR\n");
 	printf("--sbom-license <HREF>           Record HREF as the license link in the\n");
 	printf("                                generated SBOM files\n");
+	printf("--sbom-tag-id <UUID>            Use UUID as the tag-id of all generated\n");
+	printf("                                SBOM files instead of a per-blob one\n");
 }
 
 extern amd_fw_entry amd_psp_fw_table[];
@@ -638,6 +642,13 @@ int amdfwtool_getopt(int argc, char *argv[], amd_cb_config *cb_config)
 		case AMDFW_OPT_SBOM_LICENSE:
 			cb_config->sbom_license = optarg;
 			break;
+		case AMDFW_OPT_SBOM_TAG_ID:
+			if (!sbom_set_tag_id(optarg)) {
+				fprintf(stderr, "Error: SBOM tag-id must be a UUID (%s)\n\n",
+					optarg);
+				retval = 1;
+			}
+			break;
 		case AMDFW_OPT_BODY_LOCATION:
 			cb_config->body_location = (uint32_t)strtoul(optarg, &tmp, 16);
 			if (*tmp != '\0') {
diff --git a/util/amdfwtool/sbom.c b/util/amdfwtool/sbom.c
index 5140a82b60..fc52f81242 100644
--- a/util/amdfwtool/sbom.c
+++ b/util/amdfwtool/sbom.c
@@ -8,6 +8,7 @@
  *   https://github.com/PSPReverse/PSPTool
  */
 
+#include <ctype.h>
 #include <errno.h>
 #include <fcntl.h>
 #include <libgen.h>
@@ -535,6 +536,27 @@ static char *file_sha256_base64(const char *filename)
  * of the same template class must not share one.  Returns false if the
  * digest cannot be computed, the caller then falls back to the class tag-id.
  */
+/*
+ * Tag-id forced on all generated tags (--sbom-tag-id), e.g. so that all
+ * components of one firmware image are grouped under a single tag-id.
+ */
+static char forced_tag_id[37];
+
+bool sbom_set_tag_id(const char *tag_id)
+{
+	static const char fmt[] = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
+	size_t i;
+
+	if (!tag_id || strlen(tag_id) != sizeof(fmt) - 1)
+		return false;
+	for (i = 0; i < sizeof(fmt) - 1; i++) {
+		if (fmt[i] == '-' ? tag_id[i] != '-' : !isxdigit((unsigned char)tag_id[i]))
+			return false;
+	}
+	memcpy(forced_tag_id, tag_id, sizeof(forced_tag_id));
+	return true;
+}
+
 static bool make_tag_id(const char *persistent_id, const char *fs_name,
 			char out[37])
 {
@@ -582,7 +604,9 @@ static bool write_sbom_json(const char *path, const char *tag_id,
 	char *hash_b64 = NULL;
 	char blob_tag_id[37];
 
-	if (make_tag_id(persistent_id, fs_name, blob_tag_id))
+	if (forced_tag_id[0] != '\0')
+		tag_id = forced_tag_id;
+	else if (make_tag_id(persistent_id, fs_name, blob_tag_id))
 		tag_id = blob_tag_id;
 
 	if (src_file)
