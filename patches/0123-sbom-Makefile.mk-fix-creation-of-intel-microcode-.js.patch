From ca5adadb11574eaa8e14e3e1c74574b7bd7e9cb9 Mon Sep 17 00:00:00 2001
From: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
Date: Thu, 28 May 2026 00:34:36 +0300
Subject: [PATCH 123/158] sbom/Makefile.mk: fix creation of
 intel-microcode-*.json

The target didn't depend on the output directory, so the corresponding
recipe failed.

Upstream-Status: Pending
Change-Id: Ia409af3ff5d9763dec181d131f5fb5629b49f931
Signed-off-by: Sergii Dmytruk <sergii.dmytruk@3mdeb.com>
(cherry picked from commit 1fb8e08eb551e2b87f55c501095820d1633b7c9e)
---
 src/sbom/Makefile.mk | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/sbom/Makefile.mk b/src/sbom/Makefile.mk
index 7ab8fbdbca..0222ffe26c 100644
--- a/src/sbom/Makefile.mk
+++ b/src/sbom/Makefile.mk
@@ -356,7 +356,7 @@ $(build-dir)/amd-opensil.json: $(src-dir)/amd-opensil.json $(CONFIG_AMD_OPENSIL_
 		sed -i "/software-version/d" $@; \
 	fi
 
-$(build-dir)/intel-microcode-%.json: $(src-dir)/intel-microcode.json 3rdparty/intel-microcode/intel-ucode/%
+$(build-dir)/intel-microcode-%.json: $(src-dir)/intel-microcode.json 3rdparty/intel-microcode/intel-ucode/% | $(build-dir)
 	cp $< $@
 	year=$$(hexdump --skip 8 --length 2 --format '"%04x"' $(word 2,$^));\
 	day=$$(hexdump --skip 10 --length 1 --format '"%02x"' $(word 2,$^));\
