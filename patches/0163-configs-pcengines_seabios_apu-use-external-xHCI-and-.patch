From eea85dd9b96d95c2360da15bf1eb7788de65d074 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Tue, 3 Nov 2026 13:41:16 +0100
Subject: [PATCH] configs/pcengines_seabios_apu*: use external xHCI and AGESA
 SBOM files
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Update all PC Engines apu SeaBIOS configs:

 - describe the xHCI firmware and AGESA with the external SBOM files
   src/southbridge/amd/pi/hudson/xhci_sbom.json and amd-agesa.json,
   which carry the firmware versions, instead of the generated tags,
 - record the AMD blob license from the coreboot blobs repository as
   the license of the AMD blobs,
 - drop the compiler from the SBOM,
 - build SeaBIOS rel-1.16.3.2.

The apu2 and apu3 configs are also reduced to non-default options.

Upstream-Status: Pending
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
diff --git a/configs/config.pcengines_seabios_apu2 b/configs/config.pcengines_seabios_apu2
index ee72aba4eb00..0a664222cc35 100644
--- a/configs/config.pcengines_seabios_apu2
+++ b/configs/config.pcengines_seabios_apu2
@@ -1,44 +1,41 @@
-# CONFIG_CONSOLE_USE_ANSI_ESCAPES is not set
-# CONFIG_CONSOLE_USE_LOGLEVEL_PREFIX is not set
-# CONFIG_IPXE_SERIAL_CONSOLE is not set
-CONFIG_AGESA_BINARY_PI_LOCATION=0xFFE00000
-CONFIG_BOTTOMIO_POSITION=0xD0000000
-CONFIG_BUILD_IPXE=y
-CONFIG_CONSOLE_CBMEM_BUFFER_SIZE=0x20000
-CONFIG_DEFAULT_CONSOLE_LOGLEVEL_1=y
-CONFIG_HUDSON_SATA_MODE=2
-CONFIG_I2C_TRANSFER_TIMEOUT_US=500000
-CONFIG_IPXE_ADD_SCRIPT=y
-CONFIG_IPXE_CUSTOM_BUILD_ID="12345678"
-CONFIG_IPXE_SCRIPT="3rdparty/dasharo-blobs/dasharo/dasharo.ipxe"
 CONFIG_LOCALVERSION="v26.09.00.01"
-CONFIG_MEMTEST86PLUS_V5=y
-CONFIG_MEMTEST_SECONDARY_PAYLOAD=y
-CONFIG_NO_GFX_INIT=y
-CONFIG_PAYLOAD_CONFIGFILE="$(top)/src/mainboard/$(MAINBOARDDIR)/seabios_config"
-CONFIG_POST_IO_PORT=0x80
-CONFIG_PXE=y
-CONFIG_PXE_ROM_ID="8086,157b"
 CONFIG_SBOM=y
-CONFIG_SBOM_AGESA=y
+CONFIG_SBOM_AMD_BLOB_LICENSE="https://github.com/coreboot/blobs/blob/main/southbridge/amd/avalon/PSP/license.txt"
+CONFIG_SBOM_PAYLOAD=y
 CONFIG_SBOM_AMD_MICROCODE=y
+CONFIG_SBOM_AGESA=y
+# CONFIG_SBOM_AGESA_GENERATE is not set
+CONFIG_SBOM_AGESA_PATH="src/southbridge/amd/pi/hudson/amd-agesa.json"
+CONFIG_SBOM_IPXE=y
 CONFIG_SBOM_AMD_PSP_FW=y
-CONFIG_SBOM_COMPILER=y
 CONFIG_SBOM_HUDSON_XHCI_FW=y
-CONFIG_SBOM_IPXE=y
-CONFIG_SBOM_MEMTEST=y
-CONFIG_SBOM_PAYLOAD=y
