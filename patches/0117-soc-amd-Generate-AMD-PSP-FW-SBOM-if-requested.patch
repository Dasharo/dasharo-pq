 9 files changed, 42 insertions(+), 7 deletions(-)

diff --git a/src/sbom/Kconfig b/src/sbom/Kconfig
index fb2c6a9f1f..2ba67ff727 100644
--- a/src/sbom/Kconfig
+++ b/src/sbom/Kconfig
@@ -380,4 +380,28 @@ config SBOM_IPXE_PATH
 	  The path of the SBOM file describing the Software included in the build
 	  File can be a .json, .xml, .cbor, .uswid, or .pc
 
+config SBOM_AMD_PSP_FW
+	bool "Include AMD PSP firmware metadata in SBOM"
+	default n
+	depends on USE_AMDFWTOOL
+	help
+	  When enabled, amdfwtool generates a CoSWID (Concise Software
+	  Identification) SBOM JSON file for each AMD Platform Security
+	  Processor (PSP) firmware blob included in the build.
+
+	  Output files are written to build/sbom/ as
+	  amd-pspfw-<firmware-filename>.json.  A Makefile fragment
+	  (build/sbom/amd-pspfw-sbom.mk) is also generated so that the
+	  SBOM assembly step can incorporate the per-blob tags into the
+	  final sbom.uswid.
+
+	  Type classifications follow PSPTool conventions
+	  (https://github.com/PSPReverse/PSPTool):
+	    - Public key types use a dedicated tag template.
+	    - No-header types are skipped (soft fuse is never included).
+	    - Wrapped KEK types (0x21, 0x82, 0x84, 0x8d) use a template
+	      that stores the raw blob content as the version field.
+	    - Key store types (0x50, 0x51) and SEV driver (0x1a, if the
+	      $PS1 magic is present) are treated as regular PSP FW.
+
 endif
diff --git a/src/soc/amd/cezanne/Makefile.mk b/src/soc/amd/cezanne/Makefile.mk
index c13524b75c..bd26934a41 100644
--- a/src/soc/amd/cezanne/Makefile.mk
+++ b/src/soc/amd/cezanne/Makefile.mk
@@ -239,7 +239,8 @@ AMDFW_COMMON_ARGS=$(OPT_PSP_APCB_FILES) \
 		$(OPT_PSP_AB_NVRAM_BASE) \
 		$(OPT_PSP_AB_NVRAM_SIZE) \
 		--config $(CONFIG_AMDFW_CONFIG_FILE) \
-		--flashsize $(CONFIG_ROM_SIZE)
+		--flashsize $(CONFIG_ROM_SIZE) \
+		$(OPT_SBOM_DIR)
 
 $(obj)/amdfw.rom:	$(call strip_quotes, $(PSP_BIOSBIN_FILE)) \
 			$(PSP_VERSTAGE_FILE) \
diff --git a/src/soc/amd/common/Makefile.mk b/src/soc/amd/common/Makefile.mk
index a078c28d14..ff027352d9 100644
--- a/src/soc/amd/common/Makefile.mk
+++ b/src/soc/amd/common/Makefile.mk
@@ -11,6 +11,10 @@ ifneq ($(V),)
 OPT_DEBUG_AMDFWTOOL = --debug
 endif
 
+ifeq ($(CONFIG_SBOM_AMD_PSP_FW),y)
+OPT_SBOM_DIR = --sbom-dir $(obj)/sbom/amdfw
+endif
+
 ifneq ($(call strip_quotes, $(CONFIG_AMDFW_CONFIG_FILE)),)
 FIRMWARE_LOCATION=$(shell grep -e FIRMWARE_LOCATION $(CONFIG_AMDFW_CONFIG_FILE) | awk '{print $$2}')
 
