From: =?UTF-8?q?Micha=C5=82=20=C5=BBygowski?= <michal.zygowski@3mdeb.com>
Date: Fri, 6 Nov 2026 13:00:00 +0100
Subject: [PATCH] util/amdfwtool/sbom.c: Describe the Mullins SMU SCS data
 block
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

PSP entry type 0x5f is the SMU Software Configuration Settings (SCS)
data block on family 15h and 16h, but the TPM Lite driver on newer
SoCs. The SBOM code treats it as TPM Lite, a type without a header,
and skips it, so no SBOM entry describes the SMU SCS file on Mullins.

Pass the SoC to the SBOM generation and describe type 0x5f on Mullins
with a dedicated template. The SCS data block has no AMD firmware
header; it starts with a 20-byte identification string, which is not
NUL terminated, e.g. "!SCSMullins V0.0.0.1". Use that string as the
software version. It mixes text with a dotted version number, so it
cannot be compared as a numeric or semantic version and the
alphanumeric version scheme is kept.

Upstream-Status: Pending
Signed-off-by: Michał Żygowski <michal.zygowski@3mdeb.com>
diff --git a/util/amdfwtool/amdfwtool.c b/util/amdfwtool/amdfwtool.c
index 6e32f727141b..6c2da8684aee 100644
--- a/util/amdfwtool/amdfwtool.c
+++ b/util/amdfwtool/amdfwtool.c
@@ -2056,7 +2056,7 @@ int main(int argc, char **argv)
 
 	if (cb_config.sbom_dir) {
 		generate_sbom_psp(cb_config.sbom_dir, amd_psp_fw_table,
-				  cb_config.sbom_license);
+				  cb_config.sbom_license, cb_config.soc_id);
 		if (have_bios_tables(amd_bios_table))
 			generate_sbom_bios(cb_config.sbom_dir, amd_bios_table,
 					   cb_config.sbom_license);
diff --git a/util/amdfwtool/amdfwtool.h b/util/amdfwtool/amdfwtool.h
index dc7dfae3f597..c3f41b0601ae 100644
--- a/util/amdfwtool/amdfwtool.h
+++ b/util/amdfwtool/amdfwtool.h
@@ -232,7 +232,7 @@ void process_signed_psp_firmwares(const char *signed_rom,
 int find_bios_entry(enum amd_bios_type type);
 bool sbom_set_tag_id(const char *tag_id);
 void generate_sbom_psp(const char *sbom_dir, amd_fw_entry *fw_table,
-		       const char *license_href);
+		       const char *license_href, enum platform soc_id);
 void generate_sbom_bios(const char *sbom_dir, struct amd_bios_entry *fw_table,
 			const char *license_href);
 
diff --git a/util/amdfwtool/sbom.c b/util/amdfwtool/sbom.c
index 81d0b1920ed5..2d22cec8be0c 100644
--- a/util/amdfwtool/sbom.c
+++ b/util/amdfwtool/sbom.c
@@ -136,6 +136,7 @@ typedef enum {
 	FW_SBOM_REGULAR,     /* Regular PSP FW with AMD firmware header */
 	FW_SBOM_PUBKEY,      /* Public key with AMD firmware header */
 	FW_SBOM_WRAPPED_KEK, /* Wrapped KEK without standard header */
+	FW_SBOM_SMU_SCS,     /* SMU SCS data block without standard header */
 } sbom_fw_class_t;
 
 static bool type_in_array(const uint8_t *arr, size_t count, uint8_t type)
@@ -178,6 +179,8 @@ static bool has_ps1_magic(const char *filename)
  * Classify a PSP firmware type ID into an SBOM template category.
  *
  * Rules (in order of precedence):
+ *  0. SMU SCS (0x5f) on Mullins - SMU SCS template. On newer SoCs type 0x5f
+ *     is the TPM Lite driver, a NO_HDR type.
  *  1. Soft fuse (0x0b) - always skip; it is a value, not a firmware blob.
  *  2. Key store types (0x50, 0x51) - have headers; treat as regular PSP FW.
  *  3. Wrapped KEK types (0x21, 0x82, 0x84, 0x8d) - wrapped KEK template.
@@ -186,8 +189,13 @@ static bool has_ps1_magic(const char *filename)
  *  6. Public key types - pubkey template.
  *  7. All others - regular PSP FW template.
  */
-static sbom_fw_class_t classify_fw_type(enum amd_fw_type type, const char *filename)
+static sbom_fw_class_t classify_fw_type(enum amd_fw_type type, const char *filename,
+					enum platform soc_id)
 {
+	/* Rule 0: SMU SCS data block shares the type with TPM Lite */
+	if (type == AMD_FW_PSP_SMUSCS && soc_id == PLATFORM_MULLINS)
+		return FW_SBOM_SMU_SCS;
+
 	/* Rule 1: soft fuse must never appear in SBOM */
 	if (type == AMD_FW_PSP_FUSE_CHAIN)
 		return FW_SBOM_SKIP;
@@ -423,6 +431,52 @@ static bool read_fw_version(const char *filename, sbom_fw_class_t class, char *b
 	return true;
 }
 
+/*
+ * The SMU Software Configuration Settings data block (type 0x5f on Mullins)
+ * has no AMD firmware header. It starts with a 20-byte identification string,
+ * e.g. "!SCSMullins V0.0.0.1", which is not NUL terminated.
+ */
+#define SMU_SCS_VERSION_LEN	20
+
+static bool read_smu_scs_version(const char *filename, char *buf, size_t bufsize)
+{
+	char id[SMU_SCS_VERSION_LEN];
+	size_t len;
+	ssize_t n;
+	int fd;
+
+	if (bufsize <= sizeof(id))
+		return false;
+
+	fd = open(filename, O_RDONLY);
+	if (fd < 0) {
+		fprintf(stderr, "SBOM: cannot open %s: %s\n",
+			filename, strerror(errno));
+		return false;
+	}
+	n = read(fd, id, sizeof(id));
+	close(fd);
+
+	if (n != (ssize_t)sizeof(id)) {
+		fprintf(stderr, "SBOM: short read from %s\n", filename);
+		return false;
+	}
+
+	len = strnlen(id, sizeof(id));
+	while (len > 0 && id[len - 1] == ' ')
+		len--;
+
+	/* The string goes into JSON, so keep printable characters only */
+	for (size_t i = 0; i < len; i++) {
+		if (!isprint((unsigned char)id[i]) || id[i] == '"' || id[i] == '\\')
+			id[i] = '?';
+	}
+
+	memcpy(buf, id, len);
+	buf[len] = '\0';
+	return true;
+}
+
 /*
  * Read the entire file and return a newly allocated NUL-terminated hex string.
  * Used to represent wrapped-KEK content as the SBOM "software-version" field.
@@ -713,7 +767,7 @@ static bool write_sbom_json(const char *path, const char *tag_id,
  * should not appear in the SBOM.
  */
 static bool generate_entry_sbom(const char *sbom_dir, amd_fw_entry *entry,
-				const char *license_href)
+				const char *license_href, enum platform soc_id)
 {
 	char path[PATH_MAX];
 	char version[80];
@@ -729,7 +783,7 @@ static bool generate_entry_sbom(const char *sbom_dir, amd_fw_entry *entry,
 	if (!entry->filename)
 		return true;
 
-	fw_class = classify_fw_type(entry->type, entry->filename);
+	fw_class = classify_fw_type(entry->type, entry->filename, soc_id);
 	if (fw_class == FW_SBOM_SKIP)
 		return true;
 
@@ -767,6 +821,20 @@ static bool generate_entry_sbom(const char *sbom_dir, amd_fw_entry *entry,
 		return ok;
 	}
 
+	if (fw_class == FW_SBOM_SMU_SCS) {
+		if (!read_smu_scs_version(entry->filename, version, sizeof(version))) {
+			free(tmp_fn);
+			return false;
+		}
+		ok = write_sbom_json(path, TAG_ID_PSP_FW,
+				     "AMD SMU Software Configuration Settings",
+				     version, persistent_id,
+				     "AMD System Management Unit Software Configuration Settings Data Block",
+				     bname, entry->filename, license_href);
+		free(tmp_fn);
+		return ok;
+	}
+
 	/* Regular or pubkey entry: extract version from AMD firmware header */
 	if (!read_fw_version(entry->filename, fw_class, version, sizeof(version))) {
 		free(tmp_fn);
@@ -854,7 +922,7 @@ static bool generate_bios_entry_sbom(const char *sbom_dir, struct amd_bios_entry
  * Output files are written to sbom_dir as amd-pspfw-<filename>.json.
  */
 void generate_sbom_psp(const char *sbom_dir, amd_fw_entry *fw_table,
-		       const char *license_href)
+		       const char *license_href, enum platform soc_id)
 {
 	amd_fw_entry *entry;
 
@@ -868,11 +936,11 @@ void generate_sbom_psp(const char *sbom_dir, amd_fw_entry *fw_table,
 		if (!entry->filename)
 			continue;
 
-		if (classify_fw_type(entry->type, entry->filename)
+		if (classify_fw_type(entry->type, entry->filename, soc_id)
 				== FW_SBOM_SKIP)
 			continue;
 
-		generate_entry_sbom(sbom_dir, entry, license_href);
+		generate_entry_sbom(sbom_dir, entry, license_href, soc_id);
 	}
 }
 
